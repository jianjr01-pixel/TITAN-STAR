{
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node scripts/check-runtime.mjs && node scripts/run-tests.mjs",
    "test:import": "node scripts/check-runtime.mjs && node scripts/run-tests.mjs import-pipeline",
    "verify": "pnpm run check:syntax && pnpm test",
    "import:month": "node scripts/import-month.js",
    "import:supplement": "node scripts/import-model-supplement.js",
    "build": "node build.js",
    "import:wireless": "node scripts/import-wireless-overview.js"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
